APP_ENV=development
BACKEND_PORT=8080
WEB_CONCURRENCY=2
SESSION_IDLE_SECONDS=7200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MYSQL_IMAGE=mysql:8.4
MYSQL_DATABASE=hris
MYSQL_USER=hris_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=3306

# --- HR AI (NL2SQL) ---
# 비워 두면 compose 기본값 http://ai:8000 (같은 compose의 ai 서비스)
AI_BASE_URL=
# 읽기 전용 계정 URL. 비워 두면 setup.sh가 비밀번호를 만들어 채우고 setup/ai.sh가 MySQL 계정·권한을 만듦
AI_DATABASE_URL=
AI_PORT=8001

# LLM: OpenAI 호환 /chat/completions 주소 + 모델 + 키 (키는 Git에 올리지 말 것)
#  DeepSeek LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-flash (현재 V4.1-Flash)
#           LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'  LLM_JSON_MODE=1
#           생각 모드가 기본 ON이라 꺼야 함: 느려서 Flask 20초 제한에 걸리고 temperature도 무시됨
#  Gemini  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=(Google AI Studio의 Flash 모델명)
#  OpenAI  LLM_BASE_URL=https://api.openai.com/v1                                 LLM_MODEL=gpt-4o-mini
#  Ollama  LLM_BASE_URL=http://host.docker.internal:11434/v1                       LLM_MODEL=(설치한 모델명)  LLM_API_KEY는 비움
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=12
# 1이면 response_format=json_object 요청 (지원하는 제공자만)
LLM_JSON_MODE=0
# 제공자 전용 요청 옵션(JSON 객체, 작은따옴표로 감쌀 것). model·messages·temperature는 넣을 수 없음
LLM_EXTRA_BODY=
# simple | enhanced (평가 하네스는 둘 다 돌림)
NL2SQL_PROMPT_MODE=enhanced
# 키 없이 배선만 시험할 때: /app/fixtures/demo.json (실제 LLM 아님, 평가에 쓰지 말 것)
LLM_FIXTURE_FILE=
